rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil — leitura pública, escrita APENAS via Cloud Function (Admin SDK).
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Comprovantes de pagamento — escrita pelo organizador autenticado.
    match /eventos/{eventoId}/comprovantes/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Capas de eventos — leitura pública, escrita APENAS via Cloud Function (Admin SDK).
    // O upload direto do client SDK está bloqueado; a função uploadEventCover
    // verifica ownership antes de gravar.
    match /eventos/{eventoId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Banners da Base de Conhecimento — escrita restrita ao admin
    match /base_conhecimento/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email == "admin@tovia.app"
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
