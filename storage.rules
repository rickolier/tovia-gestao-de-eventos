rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil — só o próprio usuário pode escrever
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Capas de eventos — usuário autenticado pode fazer upload
    match /eventos/{eventoId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Banners da Base de Conhecimento — escrita restrita a admins autenticados
    match /base_conhecimento/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
