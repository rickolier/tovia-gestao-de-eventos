rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil — só o próprio usuário pode escrever
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Capas de eventos — apenas o criador do evento pode fazer upload
    // Nota: firestore.get() não suporta banco nomeado; a verificação de owner
    // é feita via Cloud Function proxy de upload quando App Check estiver ativo.
    // Por ora, exige autenticação + tipo + tamanho, e o path inclui o eventoId
    // para auditoria de logs.
    match /eventos/{eventoId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && request.auth.token.email_verified == true;
    }

    // Banners da Base de Conhecimento — escrita restrita ao admin
    match /base_conhecimento/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email == "admin@tovia.app"
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
