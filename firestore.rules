rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Safety Net & Catch-all Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Primitives & Helpers
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             (request.auth.token.email == "olierprado@gmail.com" ||
              exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ===============================================================
    // Validation Helpers
    // ===============================================================

    function isValidUser(data) {
      return data.nome is string && data.nome.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             (!data.keys().hasAll(['plano']) || (data.plano in ['start', 'essencial', 'pro']));
    }

    function isValidEvento(data) {
      return data.nome is string && data.nome.size() <= 200 &&
             isValidId(data.criado_por) &&
             (data.criado_por == request.auth.uid || isAdmin()) &&
             data.ativo is bool;
    }

    function isValidInscricao(data) {
      return isValidId(data.eventoId) && 
             isValidId(data.ticketId) &&
             data.status in ['pendente', 'pagamento_iniciado', 'pago', 'ajuda_solicitada', 'analise', 'cancelada'] &&
             data.valor_total is number && data.valor_total >= 0 && data.valor_total <= 1000000;
    }

    function isValidTicket(data) {
      return data.nome is string && data.nome.size() <= 100 &&
             data.tipo in ['pago', 'gratuito', 'doacao'] &&
             data.valor is number && data.valor >= 0 && data.valor <= 1000000;
    }

    function isEventOwner(id) {
      return isAdmin() || (get(/databases/$(database)/documents/eventos/$(id)).data.criado_por == request.auth.uid);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || resource.data.get('pagina_publica', false) == true;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'nome', 'whatsapp', 'instituicao', 'cargo', 'bio', 'descricao',
          'redes_social', 'link_importante_1', 'link_importante_2',
          'contato_email', 'site', 'telefone', 'imagem_url', 'updatedAt', 'plano',
          'cnpj', 'cep', 'endereco', 'numero', 'complemento', 'bairro', 'pagina_publica'
        ])
      );
      // Toggle pagina_publica isolado — sem exigir isValidUser (não toca nome/email)
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['pagina_publica']);
      // Admin pode alterar plano, planoPendente e desativado de qualquer usuário
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['plano', 'planoPendente', 'desativado']);
      allow list: if isAdmin();
    }

    match /notificacoes/{notifId} {
      // resource == null when doc doesn't exist — allow signed-in users to confirm non-existence (no data leakage)
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['lida']);
      allow create: if isOwner(incoming().userId) || isAdmin();
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /eventos/{eventoId} {
      allow get: if isValidId(eventoId); // Open get for public event page, but ID must be valid
      allow list: if (isSignedIn() && (
        resource.data.criado_por == request.auth.uid ||
        isAdmin() ||
        resource.data.get('equipeIds', []).hasAll([request.auth.uid])
      )) || (
        // Página pública do organizador: listagem sem auth quando organizador tem pagina_publica ativa
        resource.data.ativo == true &&
        get(/databases/$(database)/documents/users/$(resource.data.criado_por)).data.get('pagina_publica', false) == true
      );
      allow create: if isSignedIn() && isValidEvento(incoming());
      // Owner/admin: full update; Team member self-join: only equipe+equipeIds, adding themselves
      allow update: if (isEventOwner(eventoId) && isValidEvento(incoming()) && incoming().criado_por == existing().criado_por) ||
        (isSignedIn() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['equipe', 'equipeIds']) &&
         incoming().get('equipeIds', []).hasAll(existing().get('equipeIds', [])) &&
         incoming().get('equipeIds', []).size() == existing().get('equipeIds', []).size() + 1 &&
         incoming().get('equipeIds', []).hasAll([request.auth.uid]) &&
         !existing().get('equipeIds', []).hasAll([request.auth.uid]));
      allow delete: if isEventOwner(eventoId);

      match /tickets/{ticketId} {
        allow get: if isValidId(ticketId);
        allow list: if true;
        allow create: if isEventOwner(eventoId) && isValidTicket(incoming());
        allow update: if isEventOwner(eventoId) && isValidTicket(incoming());
        allow delete: if isEventOwner(eventoId);
      }

      match /inscricoes/{inscricaoId} {
        // get: requer autenticação mínima — participantes convidados precisam criar conta para consultar inscrição
        allow get: if isEventOwner(eventoId) || isSignedIn();
        allow list: if isEventOwner(eventoId);
        // create: público para páginas de venda, mas eventoId deve corresponder ao path
        allow create: if isValidInscricao(incoming()) && incoming().eventoId == eventoId;
        allow update: if (isEventOwner(eventoId) || (isSignedIn() && existing().get('userId', '') == request.auth.uid)) &&
          isValidInscricao(incoming()) &&
          incoming().eventoId == eventoId;
        allow delete: if isEventOwner(eventoId);
      }

      match /pessoas/{pessoaId} {
        allow read: if isEventOwner(eventoId);
        allow write: if isEventOwner(eventoId);
      }

      match /pagamentos/{pagamentoId} {
        allow read: if isEventOwner(eventoId);
        // create: apenas dono do evento pode registrar pagamentos manualmente
        allow create: if isEventOwner(eventoId) &&
          isValidId(incoming().inscricaoId) &&
          exists(/databases/$(database)/documents/eventos/$(eventoId)/inscricoes/$(incoming().inscricaoId));
        allow update, delete: if isEventOwner(eventoId);
      }

      match /transacoes/{transacaoId} {
        allow read, write: if isEventOwner(eventoId);
      }

      match /doacoes/{doacaoId} {
        allow read: if isEventOwner(eventoId);
        allow create, update, delete: if isEventOwner(eventoId);
      }

      match /quartos/{quartoId} {
        allow read, write: if isEventOwner(eventoId);
      }

      match /tarefas/{taskId} {
        allow read, write: if isEventOwner(eventoId);
      }
      
      match /alocacoes_doacoes/{alocacaoId} {
        allow read, write: if isEventOwner(eventoId);
      }

      match /paginas_venda/{paginaId} {
        allow get: if true; // público para rota pública funcionar
        allow list: if true; // público para rota pública funcionar
        allow create, update, delete: if isEventOwner(eventoId);
      }
    }

    // ===============================================================
    // Metadados públicos do organizador — apenas gateway_connected
    // ===============================================================
    match /organizer_public/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // ===============================================================
    // Base de Conhecimento — leitura pública, escrita apenas admin
    // ===============================================================
    match /base_conhecimento/{artigoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // Collection Group — admin pode listar inscricoes de todos os eventos
    // Necessário para queries collectionGroup('inscricoes') no painel admin
    // ===============================================================
    match /{path=**}/inscricoes/{inscricaoId} {
      allow list: if isAdmin();
    }
  }
}
