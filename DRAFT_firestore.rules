rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Safety Net & Catch-all Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Primitives & Helpers
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Admin detection (verified email + hardcoded for initial setup)
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email_verified == true &&
             (request.auth.token.email == "olierprado@gmail.com" || 
              exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ===============================================================
    // Validation Helpers
    // ===============================================================

    function isValidUser(data) {
      return data.nome is string && data.nome.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             (!data.keys().hasAll(['plano']) || (data.plano in ['start', 'essencial', 'pro']));
    }

    function isValidEvento(data) {
      return data.nome is string && data.nome.size() <= 200 &&
             isValidId(data.criado_por) &&
             (data.criado_por == request.auth.uid || isAdmin()) &&
             data.ativo is bool;
    }

    function isValidInscricao(data) {
      return isValidId(data.eventoId) && 
             isValidId(data.ticketId) &&
             data.status in ['pendente', 'pagamento_iniciado', 'pago', 'ajuda_solicitada', 'analise', 'cancelada'] &&
             data.valor_total is number && data.valor_total >= 0 && data.valor_total <= 1000000;
    }

    function isValidTicket(data) {
      return data.nome is string && data.nome.size() <= 100 &&
             data.tipo in ['pago', 'gratuito'] &&
             data.valor is number && data.valor >= 0 && data.valor <= 1000000;
    }

    function isEventOwner(id) {
      return isAdmin() || (get(/databases/$(database)/documents/eventos/$(id)).data.criado_por == request.auth.uid);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'nome', 'whatsapp', 'instituicao', 'cargo', 'bio', 'descricao', 
          'redes_social', 'link_importante_1', 'link_importante_2', 
          'contato_email', 'site', 'telefone', 'imagem_url', 'updatedAt'
        ]) &&
        (!incoming().keys().hasAll(['updatedAt']) || incoming().updatedAt == request.time)
      );
      allow list: if isAdmin();
    }

    match /notificacoes/{notifId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['lida']);
      allow create: if isOwner(incoming().userId) || isAdmin(); 
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /eventos/{eventoId} {
      allow get: if isValidId(eventoId); // Open get for public event page, but ID must be valid
      allow list: if isSignedIn() && (resource.data.criado_por == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidEvento(incoming()) && (
        (!incoming().keys().hasAll(['createdAt']) || incoming().createdAt == request.time)
      );
      allow update: if isEventOwner(eventoId) && isValidEvento(incoming()) && (
        incoming().criado_por == existing().criado_por &&
        (!incoming().keys().hasAll(['updatedAt']) || incoming().updatedAt == request.time)
      );
      allow delete: if isEventOwner(eventoId);

      match /tickets/{ticketId} {
        allow get: if isValidId(ticketId);
        allow list: if true;
        allow create: if isEventOwner(eventoId) && isValidTicket(incoming());
        allow update: if isEventOwner(eventoId) && isValidTicket(incoming());
        allow delete: if isEventOwner(eventoId);
      }

      match /inscricoes/{inscricaoId} {
        allow get: if isValidId(inscricaoId);
        allow list: if isEventOwner(eventoId);
        allow create: if isValidInscricao(incoming()) && (
          (!incoming().keys().hasAll(['data_inscricao']) || incoming().data_inscricao == request.time)
        );
        allow update: if (isEventOwner(eventoId) || (isSignedIn() && existing().get('userId', '') == request.auth.uid)) && (
          isValidInscricao(incoming())
        );
        allow delete: if isEventOwner(eventoId);
      }

      match /pessoas/{pessoaId} {
        allow read: if isEventOwner(eventoId);
        allow write: if isEventOwner(eventoId);
      }

      match /pagamentos/{pagamentoId} {
        allow read: if isEventOwner(eventoId);
        allow create: if isValidId(incoming().inscricaoId) && exists(/databases/$(database)/documents/eventos/$(eventoId)/inscricoes/$(incoming().inscricaoId));
        allow update, delete: if isEventOwner(eventoId);
      }

      match /transacoes/{transacaoId} {
        allow read, write: if isEventOwner(eventoId);
      }

      match /doacoes/{doacaoId} {
        allow read: if isValidId(eventoId); 
        allow create: if isValidId(eventoId) && (
          (!incoming().keys().hasAll(['data']) || incoming().data == request.time)
        );
        allow update, delete: if isEventOwner(eventoId);
      }

      match /quartos/{quartoId} {
        allow read, write: if isEventOwner(eventoId);
      }

      match /tarefas/{taskId} {
        allow read, write: if isEventOwner(eventoId);
      }
      
      match /alocacoes_doacoes/{alocacaoId} {
        allow read, write: if isEventOwner(eventoId);
      }
    }
  }
}
